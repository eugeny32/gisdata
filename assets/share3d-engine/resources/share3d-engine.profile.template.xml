<?xml version="1.0" encoding="utf-8" standalone="no"?>
<AppCfg xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Default="false" CfgFormatVersion="1.3" ThisFileVersion="2.1">
  <AppInfo>
    <Signature>
      <Name>{{APP_NAME}}</Name>
      <ExecutableName>{{EXECUTABLE_NAME}}</ExecutableName>
      <SiOpenAppName>{{APP_NAME}}</SiOpenAppName>
    </Signature>
    <Options>
      <UseSiOpenAppName>true</UseSiOpenAppName>
    </Options>
  </AppInfo>
  <CfgProperties>
    <ID>{{PROFILE_ID}}</ID>
    <Name>{{APP_NAME}}</Name>
    <InheritsFromID>ID_Default_S80_Navlib_Cfg</InheritsFromID>
  </CfgProperties>
  <Settings>
    <OverallScale>1.00</OverallScale>
  </Settings>
  <ButtonActions xmlns:driver_images="./images/3DxService/">
    <ButtonAction Type="Menu" xsi:type="ButtonAction_Menu">
      <ID>Menu_Share3D_MouseRotate</ID>
      <Name>Mouse Navigation</Name>
      <Image>
        <Source>[driver_images:HIDMouse_RadialMenu.png]</Source>
      </Image>
      <MenuID>Share3D_MouseRotate</MenuID>
    </ButtonAction>
    <ButtonAction Type="AppCommand" xsi:type="ButtonAction_AppCommand">
      <ID>AppCommand_mouseRotateMode_arcball</ID>
      <Name>Arcball</Name>
      <AppCmdID>mouseRotateMode.arcball</AppCmdID>
    </ButtonAction>
    <ButtonAction Type="AppCommand" xsi:type="ButtonAction_AppCommand">
      <ID>AppCommand_mouseRotateMode_yawPitch</ID>
      <Name>Yaw/Pitch</Name>
      <AppCmdID>mouseRotateMode.yawPitch</AppCmdID>
    </ButtonAction>
    <ButtonAction Type="AppCommand" xsi:type="ButtonAction_AppCommand">
      <ID>AppCommand_mouseTargetMode_boundsCenter</ID>
      <Name>Bounds Center</Name>
      <AppCmdID>mouseTargetMode.boundsCenter</AppCmdID>
    </ButtonAction>
    <ButtonAction Type="AppCommand" xsi:type="ButtonAction_AppCommand">
      <ID>AppCommand_mouseTargetMode_capturedPoint</ID>
      <Name>Captured Point</Name>
      <AppCmdID>mouseTargetMode.capturedPoint</AppCmdID>
    </ButtonAction>
    <ButtonAction Type="AppCommand" xsi:type="ButtonAction_AppCommand">
      <ID>AppCommand_appUndo</ID>
      <Name>Undo</Name>
      <AppCmdID>app.undo</AppCmdID>
    </ButtonAction>
    <ButtonAction Type="AppCommand" xsi:type="ButtonAction_AppCommand">
      <ID>AppCommand_appRedo</ID>
      <Name>Redo</Name>
      <AppCmdID>app.redo</AppCmdID>
    </ButtonAction>
  </ButtonActions>
  <Menus>
    <Executable>3DxPieMenus.exe</Executable>
    <Menu Type="Radial">
      <ID>Share3D_MouseRotate</ID>
      <Name>Mouse Navigation</Name>
      <GesturesEnabled>true</GesturesEnabled>
      <Style>EightButton</Style>
      <Button>
        <Input>
          <ActionID>MenuButton_1</ActionID>
        </Input>
        <Output>
          <ActionID>AppCommand_mouseRotateMode_arcball</ActionID>
        </Output>
      </Button>
      <Button>
        <Input>
          <ActionID>MenuButton_2</ActionID>
        </Input>
        <Output>
          <ActionID>AppCommand_mouseRotateMode_yawPitch</ActionID>
        </Output>
      </Button>
      <Button>
        <Input>
          <ActionID>MenuButton_3</ActionID>
        </Input>
        <Output>
          <ActionID>AppCommand_mouseTargetMode_boundsCenter</ActionID>
        </Output>
      </Button>
      <Button>
        <Input>
          <ActionID>MenuButton_4</ActionID>
        </Input>
        <Output>
          <ActionID>AppCommand_mouseTargetMode_capturedPoint</ActionID>
        </Output>
      </Button>
      <Button>
        <Input>
          <ActionID>MenuButton_5</ActionID>
        </Input>
        <Output>
          <ActionID>AppCommand_appUndo</ActionID>
        </Output>
      </Button>
      <Button>
        <Input>
          <ActionID>MenuButton_6</ActionID>
        </Input>
        <Output>
          <ActionID>AppCommand_appRedo</ActionID>
        </Output>
      </Button>
      <Button>
        <Input>
          <ActionID>MenuButton_7</ActionID>
        </Input>
        <Output>
          <ActionID>Driver_DevNull</ActionID>
        </Output>
      </Button>
      <Button>
        <Input>
          <ActionID>MenuButton_8</ActionID>
        </Input>
        <Output>
          <ActionID>Driver_DevNull</ActionID>
        </Output>
      </Button>
    </Menu>
  </Menus>
  <Devices>
    <Device>
      <ID>{{DEVICE_ID}}</ID>
      <Name>{{DEVICE_NAME}}</Name>
      <ButtonBank Default="true">
        <ID>Default</ID>
        <Name>STR_DEFAULT_BUTTONBANK</Name>
        <InheritsFromID />
{{BUTTON_BINDINGS}}
      </ButtonBank>
    </Device>
  </Devices>
  <AuthorInfo>
    <Created>
      <Tool>install-3dx-profile.ps1</Tool>
      <Version>1.0</Version>
      <Date>{{GENERATED_AT}}</Date>
      <User>Codex</User>
    </Created>
    <LastChange>
      <Tool>install-3dx-profile.ps1</Tool>
      <Version>1.0</Version>
      <Date>{{GENERATED_AT}}</Date>
      <User>Codex</User>
    </LastChange>
  </AuthorInfo>
</AppCfg>
