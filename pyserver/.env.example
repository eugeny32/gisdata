# Copy to .env on the server; never commit the real .env (matches the PHP
# app's own .env convention at the repo root).
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=server-ubuntu-1660.tail11b174.ts.net,ntrip.host
DJANGO_CSRF_TRUSTED_ORIGINS=https://server-ubuntu-1660.tail11b174.ts.net,https://ntrip.host

PGSQL_HOST=127.0.0.1
PGSQL_PORT=5432
PGSQL_DATABASE=gismap
PGSQL_USER=gismap
PGSQL_PASSWORD=

# Optional overrides — default to ../uploads and ../assets (shared with
# the legacy PHP tree during the parallel-run phase).
# UPLOADS_ROOT=/srv/gisdata/uploads
# ASSETS_ROOT=/srv/gisdata/assets